# Copy to ignored terraform.tfvars. No credentials belong in this file.
aws_account_id = "000000000000"

# Enable only after choosing an Amazon-owned AL2023 arm64 AMI in Seoul.
enable_ssm_bridge = false
# ssm_bridge_ami_id = "ami-<17 hexadecimal characters>"

# Trusted publisher only; provision state-outbox credentials before enabling.
enable_outbox_service = false
# outbox_service_image = "000000000000.dkr.ecr.ap-northeast-2.amazonaws.com/sky-platform@sha256:<64 hexadecimal characters>"

# API role is independent from the publisher; operator trust is optional and exact.
enable_api_role = false
api_operator_principal_arn = null

# Requires a CI-verified hosted image with Cognito browser support.
# Creates CloudFront, internal ALB, Cognito and one additional Fargate task.
enable_public_api = false
public_api_image = null
api_memberships = [] # Register subjects explicitly; no user or grant is auto-created.

# Existing GitHub OIDC provider and sky-managed ECR repository are reused.
# Read the repository's OIDC customization and verify its numeric IDs first.
enable_builder_role = false
builder_oidc_subject = null
# builder_oidc_subject = "repo:sangmu1126@<owner-id>/sky-builder@<repo-id>:ref:refs/heads/main"

# Provision sky_build via the explicit SQL helper before any consumer activation.
# The Secret value is published outside Terraform; GitHub App remains separate.
enable_build_worker_role = false

# One-shot trusted worker infrastructure check; no consumer/service activation.
enable_build_worker_preflight = false
build_worker_image            = null
build_worker_builder_sha      = null
build_worker_platform_sha     = null

# Persistent user-app DB, separate from Sky state; requires SSM bridge.
# Operator initialization is separate; no hosted consumer is activated.
enable_shared_workload_pool = false
shared_workload_instance_class = "db.t4g.micro"
shared_workload_connection_budget = 30
