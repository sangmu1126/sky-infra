.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
backend.hcl
terraform.tfvars
*.auto.tfvars
# 서비스 서버 이미지 SHA는 커밋한다. 이 파일만 바뀐 PR이 머지되면 자동 배포된다.
!terraform/envs/dev/platform-image.auto.tfvars
.terraformrc
terraform.rc
.DS_Store

# Python (plan audit tests)
__pycache__/
*.py[cod]
# 비밀 없는 builder ID/code pin 설정만 추적한다.
!terraform/envs/dev/builder.auto.tfvars

!terraform/envs/dev/shared-database.auto.tfvars

# Ansible: real inventories and deploy keys stay local
ansible/**/inventory.ini
ansible/**/sky_deploy_key*
ansible/**/.venv/
